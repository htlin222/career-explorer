  "meta": {
    "domains": {
      "N": {
        "zh": "神經質",
        "en": "Neuroticism",
        "desc": "對負面情緒的敏感度。分數高的人比較常感到焦慮、低落或緊繃，也比較容易被壓力推倒；分數低的人情緒基線平穩，但也可能對危險訊號比較遲鈍。這個向度測的是情緒反應的強度與頻率，不是心理健康。",
        "facets": [
          {
            "zh": "焦慮",
            "en": "Anxiety",
            "low": "你不太容易緊張，多數情況下覺得事情會沒問題。",
            "mid": "你會擔心，但通常擔心得有理由，也放得下。",
            "high": "你的警報系統很靈敏，常在事情發生前就先預演最壞的版本。"
          },
          {
            "zh": "憤怒",
            "en": "Anger",
            "low": "被冒犯時你不太動怒，脾氣算溫和。",
            "mid": "你會生氣，但多半只在該生氣的時候。",
            "high": "你對不公平或被輕視的反應很快，怒意來得又急又明顯。"
          },
          {
            "zh": "憂鬱",
            "en": "Depression",
            "low": "你少有低落期，對自己大致滿意。",
            "mid": "偶爾情緒下滑，但會自己回來。",
            "high": "你經常提不起勁、覺得沮喪，也比較容易對自己失望。"
          },
          {
            "zh": "自我意識",
            "en": "Self-Consciousness",
            "low": "你在陌生人面前自在，不太在意別人怎麼看你。",
            "mid": "有些場合會不好意思，但不至於退縮。",
            "high": "你很在意別人的眼光，在人群中容易覺得尷尬或想躲起來。"
          },
          {
            "zh": "放縱",
            "en": "Immoderation",
            "low": "你能延遲滿足，慾望對你的拉力不大。",
            "mid": "大部分時候忍得住，偶爾會破戒。",
            "high": "眼前的誘惑對你很難抗拒，常常先做了再說。"
          },
          {
            "zh": "脆弱",
            "en": "Vulnerability",
            "low": "壓力大時你反而更冷靜，能穩住場面。",
            "mid": "壓力會影響你，但不至於失去判斷。",
            "high": "事情一多一急，你容易慌掉、失去平常的判斷力。"
          }
        ]
      },
      "E": {
        "zh": "外向性",
        "en": "Extraversion",
        "desc": "你從外在世界與人際互動中得到多少能量。分數高的人主動、活躍、話多；分數低的不等於害羞或不快樂，只是獨處時比較不耗損，社交需求量本來就比較小。",
        "facets": [
